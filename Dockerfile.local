FROM php:8.3-fpm-alpine

ARG UID=1000
ARG GID=1000

RUN apk add --no-cache \
        bash git curl unzip icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev \
        oniguruma-dev mysql-client tzdata shadow $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql mbstring exif pcntl bcmath gd intl zip opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS \
    && cp /usr/share/zoneinfo/UTC /etc/localtime \
    && echo "UTC" > /etc/timezone

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Sync www-data uid/gid với host user để tránh permission khi mount volume
RUN usermod -u ${UID} www-data && groupmod -g ${GID} www-data

WORKDIR /var/www/html

USER www-data

EXPOSE 9000
CMD ["php-fpm"]
